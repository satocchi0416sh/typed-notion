{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Release Configuration",
  "description": "Configuration schema for semantic-release automation",
  "type": "object",
  "properties": {
    "branches": {
      "type": "array",
      "description": "Branch configurations for release triggers",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Simple branch name"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Branch name or pattern"
              },
              "prerelease": {
                "type": ["boolean", "string"],
                "description": "Prerelease identifier"
              }
            },
            "required": ["name"]
          }
        ]
      }
    },
    "plugins": {
      "type": "array",
      "description": "Ordered array of semantic-release plugins",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Plugin name"
          },
          {
            "type": "array",
            "description": "Plugin with configuration",
            "minItems": 1,
            "items": [
              {
                "type": "string",
                "description": "Plugin name"
              }
            ],
            "additionalItems": {
              "type": "object",
              "description": "Plugin configuration"
            }
          }
        ]
      }
    },
    "repositoryUrl": {
      "type": "string",
      "format": "uri",
      "description": "Git repository URL"
    },
    "tagFormat": {
      "type": "string",
      "description": "Git tag format template",
      "default": "v${version}"
    },
    "dryRun": {
      "type": "boolean",
      "description": "Test mode without actual publishing",
      "default": false
    },
    "debug": {
      "type": "boolean",
      "description": "Enable verbose logging",
      "default": false
    }
  },
  "required": ["branches", "plugins"],
  "examples": [
    {
      "branches": ["main"],
      "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        "@semantic-release/npm",
        "@semantic-release/github"
      ]
    },
    {
      "branches": ["main", { "name": "beta", "prerelease": true }],
      "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        ["@semantic-release/npm", { "npmPublish": true }],
        ["@semantic-release/github", { "assets": ["dist/**"] }]
      ],
      "tagFormat": "v${version}",
      "repositoryUrl": "https://github.com/user/repo.git"
    }
  ]
}
